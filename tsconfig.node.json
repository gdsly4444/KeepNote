{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["main/**/*.ts", "preload/**/*.ts", "shared/**/*.ts", "electron.vite.config.ts"],
  "exclude": ["main/fixtures/**"]
}
